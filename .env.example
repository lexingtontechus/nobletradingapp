# =============================================================================
# Noble Trading App — Environment variables
# =============================================================================
# Copy to `.env.local` (Next.js) and to Supabase secrets (via `supabase secrets set`).
# Variables marked [supabase] are only needed in the Edge Functions; those marked
# [next.js] are only needed in the Next.js app.

# ---- Clerk (auth) -----------------------------------------------------------
# [next.js] Frontend publishable key (NEXT_PUBLIC_ so it's exposed to the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# [next.js] Backend secret key — used for: server-side user lookups, JWT
# verification, AND mirroring subscription state into publicMetadata
# (the hybrid auth pattern — see supabase/functions/helio-webhook/index.ts).
CLERK_SECRET_KEY=sk_test_...

# [next.js] Clerk webhook secret (for user.created/user.updated events — optional,
# only needed if you want to sync Clerk → Supabase when a user changes their email)
CLERK_WEBHOOK_SECRET=whsec_...

# ---- Supabase ---------------------------------------------------------------
# [next.js] Public URL + publishable (anon) key (browser-safe). The browser
# uses the publishable key with RLS — policies key on auth.jwt() ->> 'sub' =
# clerk_user_id. This is also the key the portal's Talaria panel exposes for
# the Hermes agent plugin.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # public publishable key

# [next.js + supabase] Secret key — server-only, bypasses RLS.
# NEVER expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SECRET_KEY=sb_secret_...

# Auto-injected into Edge Functions (no need to set):
#   SUPABASE_URL
#   SUPABASE_SECRET_KEYS          # JSON object keyed by key name
#   SUPABASE_PUBLISHABLE_KEYS     # JSON object keyed by key name

# ---- Helio (MoonPay Commerce) ----------------------------------------------
# [next.js] Frontend Helio config
NEXT_PUBLIC_HELIO_NETWORK=test            # 'test' | 'main'
# NOTE: Helio paylink ids now come from the `plans` table (see GET /api/plans
# and /api/create-subscription). The legacy NEXT_PUBLIC_NTA_* vars below are
# only used by archived components (app/components/_archive/) and can be left
# unset in the new flow.
# NEXT_PUBLIC_NTA_SIGNALSCOUT=<paylink_id>  # Signal Scout plan paylink (legacy)
# NEXT_PUBLIC_NTA_PRECISIONPRO=<paylink_id> # Precision Pro plan paylink (legacy)

# [supabase] Helio API credentials (from Helio dashboard → Settings → API)
HELIO_API_KEY=<your_api_key>
HELIO_API_TOKEN=<your_jwt_bearer_token>
HELIO_API_BASE_URL=https://api.hel.io      # https://api.dev.hel.io for testnet

# [supabase] Webhook sharedToken — returned ONCE in the body of the webhook
# creation response. Used both as the Bearer token AND as the HMAC-SHA256 key
# for X-Signature verification. Keep this secret; rotating requires recreating
# the webhook subscription. NOTE: Helio generates a UNIQUE sharedToken per
# webhook registration, and subscription webhooks are PER-PAYLINK (no global
# subscription webhook exists). The edge function accepts a COMMA-SEPARATED
# list here — one token per registered subscription webhook (e.g. Signal Scout
# paylink + Precision Pro paylink). Create webhooks via
# POST /v1/webhook/paylink/subscription (events: STARTED,RENEWED,ENDED,
# targetUrl: https://<ref>.supabase.co/functions/v1/helio-webhook), then paste
# each returned sharedToken below, comma-separated.
HELIO_WEBHOOK_SHARED_TOKEN=<sharedToken1>,<sharedToken2>

# ---- AgentMail.to (transactional email) ------------------------------------
# [supabase] Send renewal reminder emails. Create an API key at
# https://console.agentmail.to (starts with `am_`). Free tier (3K/month) is
# plenty for a few dozen reminders/day.
AGENTMAIL_API_KEY=am_...

# [supabase] The from-address inbox id. Must be created at console.agentmail.to
# first. Use the default `@agentmail.to` domain for dev (no DNS setup), or a
# verified custom domain for prod. The inbox_id IS the full email address.
AGENTMAIL_INBOX_ID=reminders@nobletrading.agentmail.to

# [supabase] Optional: Svix signing secret for AgentMail delivery webhooks
# (message.sent / delivered / bounced / rejected). Enables the
# reminder_emails.status = 'bounced' flow. Leave empty to skip delivery tracking.
AGENTMAIL_WEBHOOK_SECRET=whsec_...

# [supabase] Redirects for the renewal charge deep-link
REMINDER_SUCCESS_URL=https://nobletrading.app/portal
REMINDER_CANCEL_URL=https://nobletrading.app/portal

# ---- Redis (per-subscriber ACL credentials) ---------------------------------
# [supabase] Admin URL for the Edge Functions that provision/revoke/rotate
# per-subscriber ACL users. MUST use TLS (rediss://). The admin user needs
# ACL management privileges (the default user works on self-hosted Redis 6+;
# on Redis Cloud, use the account-level admin credentials).
REDIS_ADMIN_URL=rediss://default:adminpassword@redis.nobletrading.app:6379

# [next.js + supabase] The host:port SUBSCRIBERS connect to (may differ from
# the admin URL — e.g. a public TLS endpoint, possibly behind a load balancer).
# Used to build the REDIS_URL=rediss://<user>:<pwd>@<host>:<port> env var the
# user copies into their bot config.
REDIS_PUBLIC_URL=rediss://redis.nobletrading.app:6379

# [next.js + supabase] AES-256-GCM key for encrypting Redis passwords + API
# keys at rest. Generate with: openssl rand -base64 32
# MUST be the same in both the Edge Function env (encrypts on provision) and
# the Next.js env (decrypts on /api/redis-credentials GET). If you rotate
# this key, all existing encrypted credentials become unreadable — you'd
# need to rotate every subscriber's password.
REDIS_CRED_ENCRYPTION_KEY=<base64 of 32 random bytes>

# [next.js + supabase] Shared secret for internal Edge Function calls.
# The helio-webhook passes this in the X-Internal-Secret header when calling
# redis-credentials-manager. Generate with: openssl rand -hex 32
# MUST match between the Next.js env (caller) and the Edge Function env (callee).
INTERNAL_FUNCTION_SECRET=<hex random string>

# ---- Discord ----------------------------------------------------------------
# Discord access is handled entirely by MoonPay/Helio's managed Discord bot:
# the paylink captures the buyer's Discord account at checkout (auto-join) and
# the bot assigns/removes the role on payment/cancel. The Helio webhook mirrors
# the captured identity into Supabase users (discord_id/discord_username) and
# Clerk publicMetadata (discordId). No OAuth flow is needed in the app.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/<invite_code>   # informational link only

# ---- Talaria (Hermes plugin) ------------------------------------------------
# [next.js] Download URL for the Talaria desktop plugin. Shown to Precision Pro
# subscribers in the portal (TalariaPluginDownloadPanel), below the Talaria
# client credentials panel. NEXT_PUBLIC_ so the client component can read it.
# NOTE: the panel renders ONLY when this has a non-empty value. Replace the
# placeholder with the real plugin artifact URL (e.g. a GitHub release asset).
NEXT_PUBLIC_TALARIA_PLUGIN=https://github.com/lexingtontechus/noble-trader-talaria
# MT5 Talaria Signal Copy (MQ5 EA). Defaults to /talaria/TalariaCopy.mq5 (public/).
# NEXT_PUBLIC_TALARIA_SIGNAL_COPY=https://.../TalariaCopy.mq5
# NEXT_PUBLIC_TALARIA_SIGNAL_COPY_SET=https://.../TalariaCopy.set

# ---- nobletradingapp-backend (portfolio analytics proxy) -------------------
# [next.js] Server-only — used by app/api/portfolio-analytics/correlation and
# .../signal-agreement to call https://github.com/lexingtontechus/nobletradingapp-backend
# (a separate, lightweight FastAPI service — NOT noble-trader-fastapi-backend,
# which is signal-generation only). NEVER expose to the browser (no
# NEXT_PUBLIC_ prefix). Defaults to the Render deployment if unset.
WEBAPP_BACKEND_URL=https://nobletradingapp-backend.onrender.com

# [next.js] Must match nobletradingapp-backend's own API_KEY setting (checked
# via the X-API-Key header). This is a DIFFERENT secret than
# noble-trader-fastapi-backend's API_KEY — separate service, separate key.
# Free-tier Render dyno: cold starts can take up to ~50s, which is why these
# routes cache results (migrations 0011-0014 for correlation, 0013 for
# signal-agreement) instead of calling on every page load.
WEBAPP_BACKEND_API_KEY=<shared secret configured on nobletradingapp-backend's Render deploy>

# ---- EOD signal accuracy report (LLM commentary) ---------------------------
# [supabase edge function] Set in Supabase Dashboard -> Edge Functions ->
# Secrets (NOT Vercel env). The report is built once daily at 21:00 UTC by the
# eod-report-generate Edge Function — a single LLM call over already-computed
# structured numbers (never web search, never per-page-view — see
# docs/worklog-eod-signal-accuracy-report.md).
# Provider: NVIDIA NIM only (OpenRouter removed 2026-10-04 — never used).
NVIDIA_NIM_API_KEY=
# Get a key at build.nvidia.com (NVIDIA NIM API catalog, OpenAI-compatible
# endpoint). Note: NVIDIA NIM access is per-model per-account — most model IDs
# 404 ("Function ... Not found for account") until enabled for your account,
# regardless of a valid API key. Verified working 2026-09-05.
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# ---- PostHog (analytics) --------------------------------------------------
# [next.js] PostHog project API key (browser-exposed)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
POSTHOG_API_HOST=https://us.i.posthog.com
POSTHOG_DEFAULT_DATE=2026-05-30

# ---- Talaria (Hermes plugin) ------------------------------------------------
# [supabase] The check-talaria-release edge function (daily cron) reuses the
# AGENTMAIL_API_KEY + AGENTMAIL_INBOX_ID defined above (lines 69-74) to email
# subscribers when a new Talaria plugin version is released. The function polls
# the public GitHub Releases API (no auth needed) and sends one email per
# subscription, deduplicated via the Idempotency-Key + plugin_release_notifications
# table. See supabase/migrations/0008_talaria_plugin_release_notifications.sql
# for the cron schedule recipe (pg_cron + net.http_post).

